# Copy to .env before using the root docker-compose.yml.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
# Match the PostgreSQL credentials above; percent-encode special URL characters.
DATABASE_URL=postgresql+psycopg://tracker:replace-with-a-long-random-alphanumeric-password@db:5432/tracker

BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
IMAGE_TAG=local
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

# Local accounts require working SMTP and a generated Fernet key.
PASSWORD_ENABLED=true
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Issue Tracker <tracker@example.com>
MAIL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Optional OIDC login (use the exact public callback URL).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Company SSO
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback

# For multiple providers or Facebook, see docs/deployment.md.
