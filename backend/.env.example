# Local development only. Compose already supplies these variables.
DATABASE_URL=postgresql+psycopg://user:password@db:5432/db
APP_BASE_URL=http://host.docker.internal:5374
API_BASE_URL=http://host.docker.internal:5301
OIDC_ISSUER=http://host.docker.internal:5152/realms/issue-tracker
OIDC_CLIENT_ID=issue-tracker
OIDC_CLIENT_SECRET=
OIDC_NAME=Company SSO
OIDC_REDIRECT_URI=http://host.docker.internal:5301/api/v1/auth/oidc/callback
COOKIE_SECURE=false
SESSION_TTL=43200
# Optional TOML configuration (environment variables take precedence).
# TRACKER_CONFIG=/workspace/backend/config.toml
# For development password accounts, start the Compose mailpit service and enable:
PASSWORD_ENABLED=false
NOTIFICATIONS_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=Issue Tracker <tracker@example.com>
# Generate a Fernet key before enabling passwords or ticket notifications.
MAIL_ENCRYPTION_KEY=
